{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Dr. Hakeem Medical AI API v1",
    "description": "Postman Collection for Dr. Hakeem Skin Disease Diagnosis AI Service (Laravel 13). Includes automatic Bearer Token capture on Login & Register.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 1. Authentication Domain",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('token', jsonData.data.token);",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('✅ Auto-saved Sanctum Bearer Token:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"سلمى محمد\",\n  \"email\": \"salma.mohamed@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"role\": \"patient\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers new user and automatically saves Sanctum Bearer token to Environment."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('token', jsonData.data.token);",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('✅ Auto-saved Sanctum Bearer Token:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"salma.mohamed@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user credentials and automatically captures Bearer token."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "👤 2. Patient Profile Domain",
      "item": [
        {
          "name": "Get Patient Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patient/profile",
              "host": ["{{baseUrl}}"],
              "path": ["patient", "profile"]
            }
          }
        },
        {
          "name": "Update Patient Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 34,\n  \"blood_group\": \"A+\",\n  \"skin_type\": \"Type II\",\n  \"conditions\": [\"Hypertension\"],\n  \"active_allergies\": [\"Penicillin\"],\n  \"settings\": {\n    \"notifications_enabled\": true,\n    \"dark_mode\": true,\n    \"language\": \"ar\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patient/settings",
              "host": ["{{baseUrl}}"],
              "path": ["patient", "settings"]
            }
          }
        }
      ]
    },
    {
      "name": "🩺 3. Diagnosis & AI Scan Domain",
      "item": [
        {
          "name": "Process Skin Scan (AI Diagnosis)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/diagnoses/process",
              "host": ["{{baseUrl}}"],
              "path": ["diagnoses", "process"]
            },
            "description": "Upload skin lesion image (file) to trigger AI prediction and return risk analysis."
          }
        },
        {
          "name": "Explain Skin Scan (Heatmap Overlay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "alpha",
                  "value": "0.45",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/diagnoses/explain",
              "host": ["{{baseUrl}}"],
              "path": ["diagnoses", "explain"]
            },
            "description": "Upload skin lesion image (file) to trigger AI explainability endpoint, generate heatmap overlay image, and return risk analysis alongside heatmap_url."
          }
        },
        {
          "name": "Get Scan History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnoses/history?per_page=15",
              "host": ["{{baseUrl}}"],
              "path": ["diagnoses", "history"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "completed", "disabled": true },
                { "key": "predicted_class", "value": "nv", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Scan Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnoses/1",
              "host": ["{{baseUrl}}"],
              "path": ["diagnoses", "1"]
            }
          }
        },
        {
          "name": "Delete Scan",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnoses/1",
              "host": ["{{baseUrl}}"],
              "path": ["diagnoses", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 4. Dashboard Domain",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "🤖 5. AI Operational Info",
      "item": [
        {
          "name": "Get AI Model Status & Metadata",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/info",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "info"]
            }
          }
        }
      ]
    }
  ]
}
